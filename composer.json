{
  "$schema":"https://getcomposer.org/schema.json",
  "name":"workrcs/storefront-backend",
  "type":"project",
  "description":"Single-seller B2C storefront backend using Laravel and MongoDB.",
  "license":"MIT",
  "require":{"php":"^8.3","ext-gd":"*","ext-mongodb":"*","laravel/framework":"^13.17","mongodb/laravel-mongodb":"^5.12"},
  "require-dev":{"fakerphp/faker":"^1.23","mockery/mockery":"^1.6","nunomaduro/collision":"^8.6","phpunit/phpunit":"^12.5"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],"test":"@php artisan test"},
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},
  "minimum-stability":"stable",
  "prefer-stable":true
}