APP_NAME="Storefront"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mongodb
DB_URI=mongodb://127.0.0.1:27017
DB_DATABASE=storefront
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
CACHE_LIMITER=file
QUEUE_CONNECTION=sync
# For production with a managed Redis instance and the PHP Redis extension, use:
# CACHE_STORE=redis
# CACHE_LIMITER=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_CACHE_DB=1
FILESYSTEM_DISK=public
# Local-only demo seller. Never use these credentials in production.
DEMO_SELLER_EMAIL=owner@example.test
DEMO_SELLER_PASSWORD=LocalDemoOnly!Change123
